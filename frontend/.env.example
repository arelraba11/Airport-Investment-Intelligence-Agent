# Copy this file to .env to override the backend URL: cp .env.example .env
#
# Full URL of the backend /chat endpoint. The app falls back to exactly this
# value when no .env is present, so local development needs no setup at all.
#
# Change it when demoing from a different machine or network — point it at
# wherever the backend is actually reachable, e.g.
#   VITE_API_URL=http://192.168.1.50:8000/chat
#   VITE_API_URL=https://airport-agent.example.com/chat
#
# Two Vite specifics: only variables prefixed with VITE_ are exposed to client
# code, and the value is inlined at build time — restart `npm run dev` or
# re-run `npm run build` after changing it.
#
# Whatever origin the frontend is served from must also be listed in the
# backend's CORS_ORIGINS (see the .env.example at the repo root).
VITE_API_URL=http://localhost:8000/chat
