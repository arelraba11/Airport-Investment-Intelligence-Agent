# Copy this file to .env and fill in your key: cp .env.example .env
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated list of browser origins allowed to call this API.
# Optional — leave unset (or omit entirely) and the backend defaults to
# http://localhost:5173, the Vite dev server origin, which is all local
# development needs.
#
# Add the frontend's real origin when demoing from another machine or
# network, e.g.
#   CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173
